---
// Chrome - desktop top nav + mobile top bar + mobile bottom nav.
// Renders as static HTML (no JS) for the static parts. Interactive bits
// (theme toggle, year picker, standings dropdown) hydrate as React islands.
//
// Active-route detection runs at build time based on Astro.url.pathname,
// replacing the runtime currentRouteName() in shell.jsx.

import ThemeToggle from './islands/ThemeToggle.jsx';
import SeasonStrip from './islands/SeasonStrip.jsx';
import StandingsDropdown from './islands/StandingsDropdown.jsx';
import GridDropdown from './islands/GridDropdown.jsx';
import SearchPalette from './islands/SearchPalette.jsx';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import currentSeason from '../data/currentSeason.js';

// Current-season meta for the season strip's live label (round X/Y + next race).
// Derived at build time from the synced current bundle; empty-bundle safe.
const csYear = Number(currentSeason.seasonYear) || new Date().getUTCFullYear();
const csCalendar = currentSeason.calendar || [];
const csTotalRounds = csCalendar.length || null;
const csDoneRounds = Object.keys(currentSeason.results || {}).length;
const csSeasonComplete = csTotalRounds != null && csDoneRounds >= csTotalRounds;
const csNextRound = !csSeasonComplete && csTotalRounds ? csDoneRounds + 1 : null;
const csNextEntry = csNextRound ? csCalendar[csDoneRounds] : null;
const csNextRaceName = csNextEntry ? (csNextEntry.name || '').replace(/\bGrand Prix\b/i, 'GP').trim() : '';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
function isRoute(prefix: string) {
  if (prefix === '/') return path === '/' || path === '';
  return path === prefix || path.startsWith(prefix + '/');
}
const route = {
  home:        isRoute('/'),
  standingsD:  isRoute('/standings-drivers'),
  standingsC:  isRoute('/standings-constructors'),
  standings:   isRoute('/standings-drivers') || isRoute('/standings-constructors'),
  calendar:    isRoute('/calendar') || isRoute('/races') || isRoute('/race.html'),
  circuits:    isRoute('/circuits') || isRoute('/circuit.html'),
  drivers:     isRoute('/drivers') || isRoute('/driver.html'),
  teams:       isRoute('/teams') || isRoute('/team.html'),
  blog:        isRoute('/blog'),
  guide:       isRoute('/guide'),
  feedback:    isRoute('/feedback'),
};
// Consolidated top-level buckets:
//  - Grid  = the field: drivers, teams, circuits
//  - Stats = the numbers: records leaderboards (+ compare, coming soon)
//  - Read  = the words: guide + blog
route.grid  = route.drivers || route.teams || route.circuits;
route.stats = isRoute('/stats') || isRoute('/records');
route.read  = isRoute('/read') || route.blog || route.guide;
const inMore = route.grid || route.read || route.feedback;
const botActive =
  route.home       ? 'home' :
  route.standings  ? 'standings' :
  route.calendar   ? 'calendar' :
  route.stats      ? 'stats' :
  inMore           ? 'more' : null;
---
<div class="f1-app">
  <!-- Desktop top nav -->
  <nav class="nav nav-desktop">
    <a class="nav-logo" href="/" aria-label="f1gures — home">
      <img class="nav-logo-img wm-dark" src="/images/logo/f1gures-wordmark-dark.png" width="560" height="141" alt="" />
      <img class="nav-logo-img wm-light" src="/images/logo/f1gures-wordmark-light.png" width="560" height="141" alt="" />
    </a>
    <div class="nav-items">
      <a class:list={['nav-item', { active: route.home }]} href="/">Home</a>

      <StandingsDropdown client:load active={route.standings} />

      <a class:list={['nav-item', { active: route.calendar }]} href="/calendar/">Calendar</a>

      <GridDropdown client:load active={route.grid} />

      <a class:list={['nav-item', { active: route.stats }]} href="/stats/">Stats</a>
      <a class:list={['nav-item', { active: route.read }]} href="/read/">Read</a>
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-controls">
      <button type="button" class="search-trigger" data-search-trigger aria-label="Search (Ctrl+K)">
        <Icon name="search" size={14} class="search-trigger-icon" />
        <span class="search-trigger-text">Search</span>
        <span class="search-trigger-kbd"><span data-search-mod>Ctrl</span> K</span>
      </button>
      <ThemeToggle client:load />
    </div>
  </nav>

  <!-- Mobile top bar -->
  <div class="topbar-mobile">
    <a class="nav-logo topbar-logo" href="/" aria-label="f1gures — home">
      <img class="nav-logo-img wm-dark" src="/images/logo/f1gures-wordmark-dark.png" width="560" height="141" alt="" />
      <img class="nav-logo-img wm-light" src="/images/logo/f1gures-wordmark-light.png" width="560" height="141" alt="" />
    </a>
    <div style="flex:1"></div>
    <button type="button" class="search-trigger-mobile icon-btn" data-search-trigger aria-label="Search">
      <Icon name="search" size={18} />
    </button>
    <ThemeToggle client:load />
  </div>

  <SeasonStrip
    client:load
    currentYear={csYear}
    nextRound={csNextRound}
    totalRounds={csTotalRounds}
    nextRaceName={csNextRaceName}
    seasonComplete={csSeasonComplete}
  />

  <slot />

  <Footer />

  <!-- Mobile bottom nav (static) -->
  <nav class="botnav botnav-mobile">
    <a class:list={['botnav-item', { active: botActive === 'home' }]} href="/" aria-current={botActive === 'home' ? 'page' : undefined}>
      <span class="botnav-icon"><Icon name="home" size={24} /></span><span class="botnav-label">Home</span>
    </a>
    <a class:list={['botnav-item', { active: botActive === 'standings' }]} href="/standings-drivers/" aria-current={botActive === 'standings' ? 'page' : undefined}>
      <span class="botnav-icon"><Icon name="list" size={24} /></span><span class="botnav-label">Standings</span>
    </a>
    <a class:list={['botnav-item', { active: botActive === 'calendar' }]} href="/calendar/" aria-current={botActive === 'calendar' ? 'page' : undefined}>
      <span class="botnav-icon"><Icon name="calendar" size={24} /></span><span class="botnav-label">Calendar</span>
    </a>
    <a class:list={['botnav-item', { active: botActive === 'stats' }]} href="/stats/" aria-current={botActive === 'stats' ? 'page' : undefined}>
      <span class="botnav-icon"><Icon name="bar-chart" size={24} /></span><span class="botnav-label">Stats</span>
    </a>
    <button
      type="button"
      class:list={['botnav-item', { active: botActive === 'more' }]}
      data-more-trigger
      aria-expanded="false"
      aria-controls="more-sheet"
      aria-label="More sections"
    >
      <span class="botnav-icon"><Icon name="more-horizontal" size={24} /></span><span class="botnav-label">More</span>
    </button>
  </nav>

  <!-- Mobile "More" bottom sheet -->
  <div class="more-backdrop" data-more-backdrop hidden></div>
  <div id="more-sheet" class="more-sheet" data-more-sheet role="dialog" aria-modal="false" aria-label="More sections" hidden>
    <div class="more-sheet-title" aria-hidden="true">More</div>
    <nav class="more-sheet-links">
      <div class="more-sheet-group" aria-hidden="true">Grid</div>
      <a class="more-sheet-link" href="/drivers/"><Icon name="users" size={18} />Drivers</a>
      <a class="more-sheet-link" href="/teams/"><Icon name="shield" size={18} />Teams</a>
      <a class="more-sheet-link" href="/circuits/"><Icon name="map-pin" size={18} />Circuits</a>
      <div class="more-sheet-group" aria-hidden="true">Read</div>
      <a class="more-sheet-link" href="/guide/"><Icon name="book-open" size={18} />Guide</a>
      <a class="more-sheet-link" href="/blog/"><Icon name="newspaper" size={18} />Blog</a>
      <div class="more-sheet-group" aria-hidden="true">More</div>
      <a class="more-sheet-link" href="/feedback/"><Icon name="message-square" size={18} />Feedback</a>
    </nav>
  </div>
  <SearchPalette client:load />
</div>

<script is:inline>
  (function () {
    if (/Mac|iPhone|iPad|iPod/.test(navigator.platform || '')) {
      document.querySelectorAll('[data-search-mod]').forEach(function (el) { el.textContent = '⌘'; });
      document.querySelectorAll('.search-trigger[aria-label]').forEach(function (el) {
        el.setAttribute('aria-label', 'Search (⌘K)');
      });
    }
  })();
</script>
<script is:inline>
  (function () {
    var trigger = document.querySelector('[data-more-trigger]');
    var sheet = document.querySelector('[data-more-sheet]');
    var backdrop = document.querySelector('[data-more-backdrop]');
    if (!trigger || !sheet || !backdrop) return;
    function setOpen(open) {
      trigger.setAttribute('aria-expanded', String(open));
      // Use a dedicated class for the open state so we don't clobber the
      // build-time `active` route highlight on More-section pages.
      trigger.classList.toggle('sheet-open', open);
      if (open) {
        sheet.hidden = false; backdrop.hidden = false;
        // Move focus into the sheet so screen readers announce it on open.
        var firstLink = sheet.querySelector('a');
        if (firstLink) firstLink.focus();
      }
      requestAnimationFrame(function () {
        sheet.classList.toggle('open', open);
        backdrop.classList.toggle('open', open);
      });
      if (!open) {
        setTimeout(function () {
          if (!sheet.classList.contains('open')) { sheet.hidden = true; backdrop.hidden = true; }
        }, 320);
      }
    }
    trigger.addEventListener('click', function () {
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });
    backdrop.addEventListener('click', function () { setOpen(false); trigger.focus(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        setOpen(false); trigger.focus();
      }
    });
  })();
</script>
